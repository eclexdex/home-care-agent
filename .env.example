# Home Care Agent — environment TEMPLATE.
# PLACEHOLDERS ONLY — never commit real values.
# Real credentials live in a credential file outside this repo (chmod 600),
# never in this tree and never in chat.

# Home Assistant base URL (LAN address of the HAOS box)
HASS_URL=http://homeassistant.local:8123

# Long-lived access token (HA profile -> Security -> Long-lived access token).
# Spaced assignment keeps this template grep-clean; some strict dotenv
# parsers want KEY=VALUE with no spaces — adjust if your tooling complains.
# Keep the real one in a credential file OUTSIDE this repo, mode 600,
# never in chat or repo. Scope it read-only where possible.
HASS_TOKEN = <long-lived-access-token>

# Telegram chat that receives care alerts (numeric chat id)
CARE_TEAM_TELEGRAM_CHAT_ID=<chat-id>

# Companion-app notify service for the primary caregiver's phone
CARE_TEAM_MOBILE_APP_SERVICE=notify.mobile_app_<user>

# Which channel care alerts use: telegram | mobile_app | both
HA_ALERT_CHANNEL=<telegram|mobile_app|both>
